{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "어비스 블루 스쿠버다이빙 커뮤니티 API 서버 (Fastify + TypeScript)",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
