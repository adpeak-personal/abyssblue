PORT=5030
CORS_ORIGIN=http://localhost:5000
UPLOAD_DIR=uploads

# MySQL
# 비밀번호는 반드시 큰따옴표로 감싸세요.
# dotenv 는 따옴표 없는 값에서 '#' 을 인라인 주석으로 보고 뒤를 잘라내며,
# 그러면 "틀린 비밀번호"가 조용히 만들어져 Access denied 만 보게 됩니다.
#   좋음: DB_PASSWORD="ab#cd!ef"
#   나쁨: DB_PASSWORD=ab#cd!ef   -> "ab" 로 잘림
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=""
DB_NAME=abyssblue

# 또는 URL 한 줄로도 됩니다. 이 방식은 특수문자를 인코딩해야 합니다 (# -> %23).
# DATABASE_URL=mysql://root:password@localhost:3306/abyssblue

# 소셜 로그인 (선택) — 키가 없으면 그 버튼은 꺼진 상태로 표시됩니다.
# 리다이렉트 URI 는 각 개발자센터에도 똑같이 등록해야 합니다.
#   카카오 https://developers.kakao.com  (REST API 키 / 시크릿은 선택)
#   네이버 https://developers.naver.com  (Client ID + Secret 둘 다 필요)
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# 리다이렉트는 프론트 주소로 받습니다 (next.config.ts 의 /api 리라이트가 백엔드로 넘깁니다).
# 그래야 로그인 쿠키가 프론트와 같은 출처에 붙습니다.
# KAKAO_REDIRECT_URI=http://localhost:5000/api/auth/oauth/kakao/callback
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# NAVER_REDIRECT_URI=http://localhost:5000/api/auth/oauth/naver/callback

# 뒷정리 작업 (선택) — 고아 이미지·오래된 알림을 주기적으로 지웁니다.
# MAINTENANCE_ENABLED=false        끄기 (기본은 켜짐)
# MAINTENANCE_INTERVAL_HOURS=6     도는 주기 (기본 6시간)
# UPLOADS_GC_GRACE_HOURS=24        글에 안 쓰인 이미지를 지우기까지의 유예 (기본 24시간)
