# 서버 /opt/abyssblue/.env 의 보기 — 실제 파일은 권한 600 으로 두고 git 에 올리지 않는다.
#   chmod 600 /opt/abyssblue/.env
#
# 비밀번호·키는 반드시 큰따옴표로 감쌀 것. 따옴표가 없으면 '#' 뒤가 주석으로 잘려
# "틀린 비밀번호"가 조용히 만들어진다 (Access denied 만 보인다).
#   좋음: DB_PASSWORD="ab#cd!ef"      나쁨: DB_PASSWORD=ab#cd!ef   -> "ab" 로 잘림

# ── 필수 ────────────────────────────────────────────────
# MySQL — 공용 DB 서버
DB_HOST=158.247.244.167
DB_PORT=3306
DB_USER=abyssblue
DB_PASSWORD=""
DB_NAME=abyssblue

# 없으면 서버가 아예 뜨지 않는다 (아무나 아는 키로 서명되는 게 더 위험해서).
# 만들기:  cd backend && npm run gen:secret
JWT_SECRET=""

# 로그인 쿠키가 붙을 프론트 주소. 콤마로 여러 개.
CORS_ORIGIN=https://abyssblue.co.kr

# ── 이미지 저장 (운영에서는 꼭 채울 것) ──────────────────
# 비우면 컨테이너 안 디스크에 저장되고, 재배포 때 올린 이미지가 전부 사라진다.
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET=""
# CloudFront 주소 — 본문에는 경로만 저장하고 보여줄 때 이걸 앞에 붙인다
IMAGE_BASE_URL=https://xxxxxxxx.cloudfront.net

# ── 휴대폰 인증 (가입·비밀번호 찾기에 필요) ───────────────
ALIGO_API_KEY=""
ALIGO_USER_ID=""
ALIGO_SENDER=""
# 실제 발송 없이 테스트하려면 true
ALIGO_TEST_MODE=false

# ── 소셜 로그인 (선택) — 비우면 그 버튼이 꺼진 채 표시된다 ──
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# KAKAO_REDIRECT_URI=https://abyssblue.co.kr/api/auth/oauth/kakao/callback
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# NAVER_REDIRECT_URI=https://abyssblue.co.kr/api/auth/oauth/naver/callback

# ── 뒷정리 (선택) ────────────────────────────────────────
# MAINTENANCE_ENABLED=false        끄기 (기본 켜짐)
# MAINTENANCE_INTERVAL_HOURS=6     도는 주기
# UPLOADS_GC_GRACE_HOURS=24        글에 안 쓰인 이미지를 지우기까지의 유예

# ABYSSBLUE_TAG 는 적지 않는다 — deploy.sh 가 배포할 때마다 맨 끝에 적는다.
